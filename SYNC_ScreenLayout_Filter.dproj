    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
    <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
    <Import Project="$(MSBuildProjectName).deployproj" Condition="Exists('$(MSBuildProjectName).deployproj')"/>
    <PropertyGroup Condition="'$(Platform)'=='Win64'">
        <ScreenLayoutPluginDir>C:\ProgramData\aviutl2\Plugin\SYNC_ScreenLayout</ScreenLayoutPluginDir>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' And '$(Platform)'=='Win64'">
        <ScreenLayoutBuildDir>$(MSBuildProjectDirectory)\Win64\SYNC_ScreenLayout_Filter\Debug</ScreenLayoutBuildDir>
        <DCC_DcuOutput>$(ScreenLayoutBuildDir)\DCU</DCC_DcuOutput>
        <DCC_ExeOutput>$(ScreenLayoutBuildDir)</DCC_ExeOutput>
        <PreBuildEvent>if not exist &quot;$(ScreenLayoutPluginDir)&quot; mkdir &quot;$(ScreenLayoutPluginDir)&quot;
if not exist &quot;$(DCC_DcuOutput)&quot; mkdir &quot;$(DCC_DcuOutput)&quot;
if exist &quot;$(ScreenLayoutPluginDir)\$(PROJECTNAME).dll&quot; del /Q &quot;$(ScreenLayoutPluginDir)\$(PROJECTNAME).dll&quot;
if exist &quot;$(ScreenLayoutPluginDir)\$(PROJECTNAME).rsm&quot; del /Q &quot;$(ScreenLayoutPluginDir)\$(PROJECTNAME).rsm&quot;
if exist &quot;$(ScreenLayoutPluginDir)\$(PROJECTNAME).exe&quot; del /Q &quot;$(ScreenLayoutPluginDir)\$(PROJECTNAME).exe&quot;</PreBuildEvent>
        <PreBuildEventIgnoreExitCode>False</PreBuildEventIgnoreExitCode>
        <PostBuildEvent>set ScreenLayoutCopyResult=0
copy /Y &quot;$(ScreenLayoutBuildDir)\$(PROJECTNAME).dll&quot; &quot;$(ScreenLayoutPluginDir)\$(PROJECTNAME).auf2&quot; || set ScreenLayoutCopyResult=1
copy /Y &quot;$(MSBuildProjectDirectory)\Lib\Skia\Win64\sk4d.dll&quot; &quot;$(ScreenLayoutPluginDir)\sk4d.dll&quot; || set ScreenLayoutCopyResult=1
if exist &quot;$(ScreenLayoutBuildDir)\$(PROJECTNAME).dll&quot; del /Q &quot;$(ScreenLayoutBuildDir)\$(PROJECTNAME).dll&quot;
if exist &quot;$(ScreenLayoutBuildDir)\$(PROJECTNAME).rsm&quot; del /Q &quot;$(ScreenLayoutBuildDir)\$(PROJECTNAME).rsm&quot;
if exist &quot;$(ScreenLayoutBuildDir)\$(PROJECTNAME).exe&quot; del /Q &quot;$(ScreenLayoutBuildDir)\$(PROJECTNAME).exe&quot;
exit /B %ScreenLayoutCopyResult%</PostBuildEvent>
        <PostBuildEventIgnoreExitCode>False</PostBuildEventIgnoreExitCode>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' And '$(Platform)'=='Win64'">
        <ScreenLayoutBuildDir>$(MSBuildProjectDirectory)\Win64\SYNC_ScreenLayout_Filter\Release</ScreenLayoutBuildDir>
        <DCC_DcuOutput>$(ScreenLayoutBuildDir)\DCU</DCC_DcuOutput>
        <DCC_ExeOutput>$(ScreenLayoutBuildDir)</DCC_ExeOutput>
        <PreBuildEvent>if not exist &quot;$(ScreenLayoutPluginDir)&quot; mkdir &quot;$(ScreenLayoutPluginDir)&quot;
if not exist &quot;$(DCC_DcuOutput)&quot; mkdir &quot;$(DCC_DcuOutput)&quot;
if exist &quot;$(ScreenLayoutPluginDir)\$(PROJECTNAME).dll&quot; del /Q &quot;$(ScreenLayoutPluginDir)\$(PROJECTNAME).dll&quot;
if exist &quot;$(ScreenLayoutPluginDir)\$(PROJECTNAME).rsm&quot; del /Q &quot;$(ScreenLayoutPluginDir)\$(PROJECTNAME).rsm&quot;
if exist &quot;$(ScreenLayoutPluginDir)\$(PROJECTNAME).exe&quot; del /Q &quot;$(ScreenLayoutPluginDir)\$(PROJECTNAME).exe&quot;</PreBuildEvent>
        <PreBuildEventIgnoreExitCode>False</PreBuildEventIgnoreExitCode>
        <PostBuildEvent>set ScreenLayoutCopyResult=0
copy /Y &quot;$(ScreenLayoutBuildDir)\$(PROJECTNAME).dll&quot; &quot;$(ScreenLayoutPluginDir)\$(PROJECTNAME).auf2&quot; || set ScreenLayoutCopyResult=1
copy /Y &quot;$(MSBuildProjectDirectory)\Lib\Skia\Win64\sk4d.dll&quot; &quot;$(ScreenLayoutPluginDir)\sk4d.dll&quot; || set ScreenLayoutCopyResult=1
if exist &quot;$(ScreenLayoutBuildDir)\$(PROJECTNAME).dll&quot; del /Q &quot;$(ScreenLayoutBuildDir)\$(PROJECTNAME).dll&quot;
if exist &quot;$(ScreenLayoutBuildDir)\$(PROJECTNAME).rsm&quot; del /Q &quot;$(ScreenLayoutBuildDir)\$(PROJECTNAME).rsm&quot;
if exist &quot;$(ScreenLayoutBuildDir)\$(PROJECTNAME).exe&quot; del /Q &quot;$(ScreenLayoutBuildDir)\$(PROJECTNAME).exe&quot;
exit /B %ScreenLayoutCopyResult%</PostBuildEvent>
        <PostBuildEventIgnoreExitCode>False</PostBuildEventIgnoreExitCode>
    </PropertyGroup>
