<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{65AA0E2E-CE0A-4BAE-A761-66AB46E5525D}</ProjectGuid>
        <ProjectVersion>20.4</ProjectVersion>
        <FrameworkType>VCL</FrameworkType>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <Platform Condition="'$(Platform)'==''">Win64</Platform>
        <ProjectName Condition="'$(ProjectName)'==''">ScreenDesignMaker</ProjectName>
        <TargetedPlatforms>2</TargetedPlatforms>
        <AppType>Application</AppType>
        <MainSource>ScreenDesignMaker.dpr</MainSource>
        <Base>True</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win64' and '$(Cfg_1)'=='true') or '$(Cfg_1_Win64)'!=''">
        <Cfg_1_Win64>true</Cfg_1_Win64>
        <CfgParent>Cfg_1</CfgParent>
        <Cfg_1>true</Cfg_1>
        <Base>true</Base>
        <ScreenDesignBuildDir>$(MSBuildProjectDirectory)\Win64\ScreenDesignMaker\Debug</ScreenDesignBuildDir>
        <DCC_DcuOutput>$(ScreenDesignBuildDir)\DCU</DCC_DcuOutput>
        <DCC_ExeOutput>$(ScreenDesignBuildDir)</DCC_ExeOutput>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;Vcl;Winapi;$(DCC_Namespace)</DCC_Namespace>
        <DCC_UnitSearchPath>Lib\VerticalScrollBar;Lib\ColorPicker;Source\ObjectProperties;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <SanitizedProjectName>ScreenDesignMaker</SanitizedProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_DebugInformation>1</DCC_DebugInformation>
        <DCC_LocalDebugSymbols>true</DCC_LocalDebugSymbols>
        <DCC_Optimize>false</DCC_Optimize>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1_Win64)'!=''">
        <BT_BuildType>Debug</BT_BuildType>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2)'!=''">
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
        <DCC_DebugInformation>0</DCC_DebugInformation>
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
        <DCC_Optimize>true</DCC_Optimize>
        <ScreenDesignBuildDir>$(MSBuildProjectDirectory)\Win64\ScreenDesignMaker\Release</ScreenDesignBuildDir>
        <DCC_DcuOutput>$(ScreenDesignBuildDir)\DCU</DCC_DcuOutput>
        <DCC_ExeOutput>$(ScreenDesignBuildDir)</DCC_ExeOutput>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="Lib\TextRenderer\TextRendererSkiaBootstrap.pas"/>
